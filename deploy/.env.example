# Copy to deploy/.env and fill in. Never commit the real .env file.

# Public domain of the API (DNS must point to this server).
API_DOMAIN=api.example.com
# Web app origin(s) allowed by CORS, comma-separated.
WEB_ORIGINS=https://app.example.com

# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
POSTGRES_PASSWORD=

# Required in production for password reset and e-mail verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=AIT <no-reply@example.com>

# See docs/SOSYAL_GIRIS_KURULUMU.md (leave empty to keep them disabled).
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

VIDEO_RETENTION_DAYS=30
